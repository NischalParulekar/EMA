# Copy this file to .env and fill in real values. .env is gitignored.

# Claude API
ANTHROPIC_API_KEY=your_key_here

# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://ema_user:ema_pass@localhost:5432/ema_db

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333

# Mem0
MEM0_QDRANT_URL=http://localhost:6333
MEM0_COLLECTION=ema_memories

# App settings
APP_ENV=development
LOG_LEVEL=INFO

# Model routing thresholds
HAIKU_AROUSAL_THRESHOLD=0.3
OPUS_COMPLEXITY_THRESHOLD=0.8

# Canary tokens
CANARY_PREFIX=EMA
